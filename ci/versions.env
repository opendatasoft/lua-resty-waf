# Every pin for the hermetic test image, in one reviewable file.
#
# This file IS the lockfile. The image built from it is disposable and is
# never pushed anywhere. Reproducibility comes from these inputs, not
# from a stored artifact. `make verify-manifest` diffs a fresh build
# against ci/manifest.lock to catch upstream drifting out from under us.
#
# Consumed by the Makefile, which turns every KEY=VALUE below into a
# --build-arg. Keep it strictly KEY=VALUE, no shell expansion.

# base
BASE_IMAGE=debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171

# Debian's time-travel archive. Pins every apt package to what the
# archive served at this instant, so a rebuild resolves identically.
DEBIAN_SNAPSHOT=20260916T000000Z

# openresty
# NOTE: on Debian the repo component is 'openresty', NOT 'main' as on
# Ubuntu. Getting this wrong yields a silent 404 on the Packages index.
#
# Only the --with-debug build is installed. t/acceptance/http/
# 01_protocol_violations.t asserts on nginx *core* debug log lines, which
# a production build never emits. Safe because all four of the project's
# .so libs are pure FFI (zero Lua C API symbols), so one `make` output is
# valid under any prefix.
OPENRESTY_VERSION=1.31.1.1-1~bookworm1
OPENRESTY_OPENSSL3=3.5.7-1~bookworm1
OPENRESTY_PCRE2=10.48-1~bookworm1
OPENRESTY_ZLIB=1.3.2-1~bookworm1
OPENRESTY_PREFIX=/usr/local/openresty-debug

# opm modules (exact pins; '=' constraints are supported)
OPM_IPUTILS=hamishforbes/lua-resty-iputils=0.3.0
OPM_COOKIE=p0pr0ck5/lua-resty-cookie=0.01
OPM_LIBINJECTION=p0pr0ck5/lua-ffi-libinjection=0.1.1
OPM_LOGGER=p0pr0ck5/lua-resty-logger-socket=0.03

# luarocks
# lrexlib-pcre needs PCRE1 headers. Bookworm still ships libpcre3-dev;
# Ubuntu 26.04 dropped it, which is why this rock could not be built
# there. On bookworm the full ROCK_DEPS list is satisfiable.
ROCK_LREXLIB_PCRE=2.7.2-1
ROCK_LREXLIB_PCRE2=2.9.4-1
ROCK_BUSTED=2.3.0-1
ROCK_LUAFILESYSTEM=1.9.0-1

# perl / CPAN (cpanm Module@version does exact-version installs)
CPAN_TEST_NGINX=0.32
CPAN_CLONE=0.50
CPAN_LIST_MOREUTILS=0.430
CPAN_TRY_TINY=0.32
CPAN_EXPORTER_DECLARE=0.114
CPAN_TEST_EXCEPTION=0.43
CPAN_TEST_MOCKMODULE=v0.185.3
CPAN_TEST_WARN=0.37
CPAN_JSON=4.10

# test tooling
# rebusted runs the t/translation busted specs inside resty. .travis.yml
# fetched this from a master URL; pinned here to the 0.0.1-1 release.
REBUSTED_SHA=28658fc4e4453fc21f14c7d829e1499647d637a0

# lua-aho-corasick's test Makefile fetches these at *test* time over
# ftp://, which no proxied network serves. Baked into the image instead
# so the suite can run with --network none.
FIXTURE_URL=https://ftp.gnu.org/gnu/gcc/gcc-1.42.tar.gz
FIXTURE_SHA256=1f70b103bb9ad7370a5600dc217b16df36b1aa808cf311420404548dcec73bf1
